.venv/
.env
__pycache__/
*.pyc

# The puzzle dump (C.3) is hundreds of MB -- subset it at build time.
data/puzzles/*
!data/puzzles/subset.csv
!data/puzzles/dev_sample.csv

# data/openings/*.tsv IS committed: 400 KB of CC0 data, and the image must
# not depend on a GitHub fetch at build or boot time.

# maia2 .pt weights + config (280 MB), downloaded by from_pretrained() for the
# offline export only. Never committed, never in the image.
maia2_models/
.venv-export/

# A.5: the 93 MB .onnx is fetched at Docker build time from a release asset
# (GitHub hard-blocks files >100 MB). models/maia2_meta.json IS committed --
# it is ~21 KB and the runtime refuses to load the model without it.
models/*.onnx

# Cached Lichess reference games for tests/ (refetchable with --refresh)
tests/.cache/

# E.4: Vite's build output. Generated by `cd frontend && npm run build`, and
# emptied on every build -- never edit it by hand.
static/
frontend/node_modules/

# Local runtime state and OS/editor noise
data/app.db*
.DS_Store
frontend/tsconfig.tsbuildinfo
frontend/dist/
