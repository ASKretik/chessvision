# Copy to .env for local dev. .env is gitignored -- E.5: no keys in the repo.
ENV=development
LOG_LEVEL=INFO

# Supabase -> Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=        # client-safe; served to the browser via GET /config
SUPABASE_SERVICE_KEY=     # SERVER ONLY -- bypasses RLS. Never ship to a client.

# Part B commentary. Blank is fine: B.1's deterministic facts (material,
# hanging pieces, tactical motifs, king safety) are still produced, and the
# prose layers report themselves unavailable with a reason.
# "groq" (free tier, default) or "anthropic" (metered, higher quality).
LLM_PROVIDER=groq
# One key, whichever provider you chose. GROQ_API_KEY / ANTHROPIC_API_KEY
# are also read, so an existing export keeps working.
LLM_API_KEY=
# Blank uses the provider's default: openai/gpt-oss-120b for groq (a
# production model with strict JSON-schema decoding), claude-opus-5 for
# anthropic.
LLM_MODEL=

# B.4 cost control. The per-game cap bounds one analysis; RATE_LIMIT_PER_HOUR
# above bounds one caller. Comments are also cached by (FEN, move) and
# batched, so a game costs far fewer calls than it has commented moves.
MAX_COMMENTS_PER_GAME=18
# Leave empty for the provider's default (Groq 5, Anthropic larger).
COMMENT_BATCH_SIZE=

# Comma-separated. localhost:3000 and :5173 are added automatically in dev.
FRONTEND_ORIGIN=https://your-app.vercel.app

STOCKFISH_PATH=stockfish
STOCKFISH_HASH_MB=16
STOCKFISH_THREADS=1
MAIA2_ONNX_PATH=models/maia2.onnx

# Which pretrained Maia-2 to export (tools/export_maia2_onnx.py --type).
# rapid is the default: trained on longer games, so moves reflect
# understanding rather than clock panic, which is what post-game analysis
# reasons about. Switch to blitz and re-export if most pasted games are fast.
# The live model's type is recorded in maia2_meta.json and reported in the
# API response as rating_estimate.model_type.
MAIA2_MODEL_TYPE=rapid

MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=3600
RATE_LIMIT_PER_HOUR=20

# E.3 memory budget. Render free = 512; Starter = 2048.
MEMORY_BUDGET_MB=512
# Refuse new jobs below this much free. Must exceed STOCKFISH_HASH_MB with
# slack -- it is what an admitted job is about to allocate.
MEMORY_HEADROOM_MB=64
# Load the 93 MB of weights at startup, not on first request.
MAIA2_PRELOAD=1
MEMORY_SAMPLE_SECONDS=5
