# E.1 -- deploy target for Render.
#
# Memory budget (E.3): 512 MB holds Python + FastAPI + onnxruntime +
# Maia-2 weights + the Stockfish process + its hash table. Hence slim
# base, no build toolchain in the final layer, and no torch anywhere.

# --------------------------------------------------------------------------
# E.4 frontend. A separate stage because the runtime image is python-slim
# and has no Node: building here keeps ~200 MB of node_modules out of the
# final layer, which the memory budget above cannot spare.
#
# `npm run build` is `tsc -b && vite build`, so a type error fails the image
# rather than shipping a broken bundle. Run it locally before pushing.
#
# The build writes to ../static (frontend/vite.config.ts), which from /ui is
# /static -- copied into the runtime image below and served by spa.py.
# --------------------------------------------------------------------------
FROM node:20-slim AS frontend
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json* ./
# `npm ci` needs a lockfile and is the right call in CI. There is no lockfile
# committed yet (it is generated by the first `npm install`), so fall back
# rather than failing the build on a file that does not exist yet.
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY frontend/ ./
RUN npm run build && ls -la /static

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Stockfish from Debian: no compiler needed in the image, and the binary
# is ~1 MB. STOCKFISH_PATH below points at it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends stockfish \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

# The built SPA, from the Node stage. It lands in static/, which spa.py
# mounts; .dockerignore keeps any local build out so this is the only source.
COPY --from=frontend /static /app/static

# A.5 weights. The .onnx is 93 MB -- 7 MB from GitHub's hard file limit -- so
# it is NOT committed; only maia2_meta.json is. Upload the .onnx as a release
# asset and pass its URL at build time:
#
#   docker build --build-arg MAIA2_ONNX_URL=https://github.com/<you>/<repo>/\
#       releases/download/maia2-rapid-v1/maia2.onnx .
#
# Fetched at BUILD time, never at boot: a cold start after Render's 15-min
# idle sleep must not also wait on a 93 MB download (plan.md F).
#
# Unset is allowed and the image still builds -- A.5 then reports the rating
# estimate unavailable with a reason and the other five sub-parts are
# unaffected. A failed download or a checksum mismatch degrades the same way
# instead of failing the whole deploy: the bad or partial file is deleted, so
# a wrong model is never loaded. MAIA2_ONNX_SHA256 is verified when provided.
ARG MAIA2_ONNX_URL=""
ARG MAIA2_ONNX_SHA256=""
RUN set -u; \
    if [ -n "$MAIA2_ONNX_URL" ]; then \
      echo "Fetching Maia-2 weights..."; \
      mkdir -p /app/models; \
      if ! python -c "import urllib.request,sys; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" \
          "$MAIA2_ONNX_URL" /app/models/maia2.onnx; then \
        echo "WARNING: could not download $MAIA2_ONNX_URL -- rating estimate disabled"; \
        rm -f /app/models/maia2.onnx; \
      elif [ -n "$MAIA2_ONNX_SHA256" ] && \
          ! echo "$MAIA2_ONNX_SHA256  /app/models/maia2.onnx" | sha256sum -c -; then \
        echo "WARNING: maia2.onnx checksum mismatch -- deleted, rating estimate disabled"; \
        rm -f /app/models/maia2.onnx; \
      else \
        ls -lh /app/models/maia2.onnx; \
      fi; \
    else \
      echo "MAIA2_ONNX_URL unset -- A.5 rating estimate will report unavailable"; \
    fi

# E.3 memory budget. Render free is 512 MB and must hold Python + FastAPI +
# onnxruntime + 93 MB of Maia-2 weights + Stockfish + its hash table.
#
#   STOCKFISH_HASH_MB  the largest single tunable; 16 is plenty at depth ~14
#   OMP_NUM_THREADS    onnxruntime defaults to a thread per core, and each
#                      thread brings its own allocation arena
#   MEMORY_HEADROOM_MB must exceed STOCKFISH_HASH_MB with slack -- it is what
#                      a newly admitted job is about to allocate
#   MAIA2_PRELOAD      load the weights at startup so the footprint is
#                      predictable and the cost lands in the deploy rather
#                      than in a user's first analysis
#
# Read /ops/memory after driving load to settle plan.md §8.7.
ENV STOCKFISH_PATH=/usr/games/stockfish \
    STOCKFISH_HASH_MB=16 \
    STOCKFISH_THREADS=1 \
    MAIA2_ONNX_PATH=/app/models/maia2.onnx \
    MAIA2_PRELOAD=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    MEMORY_BUDGET_MB=512 \
    MEMORY_HEADROOM_MB=64 \
    MEMORY_SAMPLE_SECONDS=5 \
    ENV=production \
    PORT=10000

# Non-root, as Render expects.
RUN useradd -m -u 10001 appuser && chown -R appuser /app
USER appuser

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,os,sys; sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/health', timeout=4).status==200 else 1)"

# One worker only: each worker would own its own Stockfish process and
# onnxruntime session. Concurrency is bounded by MAX_CONCURRENT_JOBS instead.
CMD ["sh", "-c", "uvicorn partE:app --host 0.0.0.0 --port ${PORT} --workers 1 --timeout-keep-alive 75"]
