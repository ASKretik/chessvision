# Copy to .env.local for development. Vite only exposes VITE_-prefixed vars.

# Leave EMPTY for the single-service deploy and for local dev: the API is
# same-origin (partE.py serves the SPA in production, Vite proxies in dev).
# Set it only if you host the frontend on a different origin, which also
# means turning CORS on in the backend.
VITE_API_BASE=

# Where the Vite dev proxy sends API paths.
VITE_DEV_BACKEND=http://127.0.0.1:8000

# Supabase. These are PUBLIC values and are safe in the bundle; the anon key
# is designed to be. Prefer reading them from GET /config at runtime instead,
# so one build works across environments — these are the fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
