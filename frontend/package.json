{
  "name": "chess-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke-render.mjs / && node scripts/smoke-render.mjs new 45000 && node scripts/smoke-click.mjs",
    "smoke:game": "node scripts/smoke-render.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "chess.js": "1.0.0-beta.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
